{% extends 'base.html.twig' %}

{% block title %}
    Mon Profil
{% endblock %}

{% block body %}

    <main class="profil-main">

        <h1 class="profil-h1">Mon compte</h1>

        <section class="profil-1">

            <h2 class="profil-h2">Mes commandes</h2>

            {% if userOrders is not empty %}

                <table class="order-table">
                    <thead>
                    <tr>
                        <th>N°</th>
                        <th>Date</th>
                        <th>Prix</th>
                    </tr>

                    </thead>
                    <tbody>

                    {% for order in userOrders %}
                        <tr>
                            <td>{{ order.id }}</td>
                            <td>{{ order.date|date('m/d/Y') }}</td>
                            <td>{{ order.price|number_format('2', ',') }}€</td>
                        </tr>

                        <hr>

                    {% endfor %}

                    </tbody>

                </table>
            {% else %}

                <p>Aucune commande passée pour le moment !</p>

            {% endif %}



        </section>


        <section class="profil-2">

            <h3>Mon accès API</h3>

            <button class="base-button"><a href="{{ path('app_enable_api') }}">Activer mon accès API</a></button>
            {% for message in app.flashes('success') %}
                <p class="flash-success success-api">{{ message }}</p>
            {% endfor %}

        </section>


        <section class="profil-3">
            <button class="base-button"><a href="{{ path('app_delete_account') }}">Supprimer mon compte</a></button>
        </section>

    </main>





{% endblock %}

